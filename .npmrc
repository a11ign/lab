# THE EARLY HALF OF THE PNPM LOCK, FOR THIS PACKAGE (#2962, after #2958 did it for the root; one file since #4215 put the package at the root).
#
# With the switch on, npm checks `engines.npm` in package.json (a range no npm satisfies, whose text is the message it prints) before it fetches anything, and stops with EBADENGINE.
# Either alone refuses nothing: without the switch npm only warns.
#
# Only this package: it is the one PRIVATE package with dependencies. The published ones cannot carry `engines.npm`, which would refuse
# their consumers' `npm install` too (one-package-manager.test.ts names that limit).
engine-strict=true
