{
  // The lab's OWN program, and this repository's ONLY tsconfig (#4215), run by `ci.yml` from the core checkout the lab is laid into, as `packages/lab` (`pnpm exec tsc -p packages/lab/tsconfig.json`): the core's `tsc --noEmit` excludes `packages/lab` and
  // so checks the core alone. It EXTENDS the core's tsconfig, so the compiler options are the core's and not a copy of them, and replaces `include`, which is the core's population.
  // The core's `.d.ts` declarations are named by path, because a program without them fails TS2304 on `UntypedTool` (174 errors in 7 files, measured 2026-10-07) and TS7016 on `agent-org`'s modules.
  // Not a file at the core's root: one naming the lab's paths is read as a new layer edge there (the first attempt, a11ign/a11ign#3904).
  "extends": "../../tsconfig.json",
  "include": [
    "../../scripts/test-support/*.d.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "nightly/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.mjs",
    "scripts/**/*.mjs",
    "*.mjs"
  ],
  "exclude": ["node_modules"]
}
