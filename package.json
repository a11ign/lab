{
  "name": "@a11ign/lab",
  "version": "0.1.41",
  "description": "Internal: the eval harness, the training corpus pipeline, the release gates and the analysis programs. Never published.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "npm": "use pnpm instead: run pnpm install"
  },
  "scripts": {
    "layout-check": "node node_modules/@a11ign/toolchain/dist/layout-check.mjs",
    "test": "rstest run --config scripts/rstest/rstest.config.ts",
    "changeset": "changeset",
    "spike": "tsx src/harnesses/run-spike.ts",
    "eval": "A11Y_PYTHON=.venv/bin/python tsx src/eval/run.ts",
    "eval:capture": "A11Y_PYTHON=.venv/bin/python node src/harnesses/capture-fixtures.ts",
    "eval:gate": "A11Y_PYTHON=.venv/bin/python EVAL_GATE=1 EVAL_RUNS=3 tsx src/eval/run.ts",
    "training:generate": "node src/training/generate-screenreader-dataset.mjs",
    "training:generate-acceptance": "node src/training/generate-screenreader-acceptance.mjs",
    "training:preflight": "node src/training/preflight-screenreader-dataset.mjs",
    "training:preflight-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance node src/training/preflight-screenreader-dataset.mjs",
    "training:capture-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_PAGES_PORT=5051 DATASET_BASE_URL=http://localhost:5051 DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} tsx src/training/capture-screenreader-dataset.mjs",
    "training:export-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} node src/training/export-screenreader-dataset.mjs --out=runs/screenreader-acceptance/${REPEAT:-repeat-1}.jsonl",
    "training:capture": "tsx src/training/capture-screenreader-dataset.mjs",
    "training:status": "node src/training/capture-status.mjs",
    "training:wait": "node src/training/wait-for-capture.mjs",
    "scorer:explain": "node scripts/explain-scorer.ts",
    "training:check-signals": "node src/training/check-signals.mjs",
    "training:check-signals:complete": "node src/training/check-signals.mjs --require-complete",
    "training:build-realism": "node scripts/build-realism-tier.ts --out=runs/screenreader-dataset/with-realism.jsonl",
    "lab:retrain": "node scripts/retrain-pipeline.ts",
    "lab:everything": "node scripts/everything-pipeline.ts",
    "lab:full-page-claims": "node scripts/full-page-claims.ts",
    "training:export": "node src/training/export-screenreader-dataset.mjs",
    "training:export:test": "A11Y_DATASET_GRADE=test node src/training/export-screenreader-dataset.mjs",
    "training:analyze-errors": ".venv/bin/python scripts/report-screenreader-errors.py",
    "training:evaluate-acceptance": ".venv/bin/python scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl",
    "training:evaluate-acceptance:shipped": "rm -rf runs/model-shipped && mkdir -p runs && cp -r node_modules/@a11ign/scorer/models/screenreader-scorer runs/model-shipped && .venv/bin/python scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --model runs/model-shipped --training-report runs/model-shipped/training-report.json --out runs/model-shipped/acceptance-report.json",
    "training:hardening": ".venv/bin/python scripts/check-screenreader-hardening.py",
    "training:train": "node scripts/build-realism-tier.ts --out=runs/screenreader-dataset/with-realism.jsonl && .venv/bin/python scripts/train-screenreader-model.py --data runs/screenreader-dataset/with-realism.jsonl --output runs/model-candidate",
    "training:train-baseline": ".venv/bin/python scripts/train-screenreader-model.py --output runs/model-baseline",
    "evidence:check": "tsx scripts/evidence-check.ts",
    "gate:stability": "tsx scripts/stability-gate.ts",
    "gate:nvda-release": "node scripts/nvda-release-gate.ts",
    "lab:inventory": "node scripts/lab-inventory.ts",
    "corpus:snapshot": "node scripts/corpus-snapshot.ts",
    "corpus:prune-orphans": "node scripts/corpus-prune-orphans.ts",
    "corpus:backup": "node scripts/corpus-backup.ts",
    "training:repeat": "tsx src/training/repeat-capture.mjs",
    "rules:score": "tsx scripts/score-rules.ts",
    "rules:gate": "tsx scripts/score-rules.ts --gate",
    "rules:coverage": "tsx scripts/audit-rule-coverage.ts",
    "rules:real-pages": "tsx scripts/check-real-page-findings.ts",
    "scorer:shortcuts": "pnpm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl",
    "promote:model": "node scripts/promote-model.ts",
    "docs:coverage": "tsx scripts/generate-coverage-doc.ts",
    "corpus:starvation": "node scripts/audit-corpus-starvation.ts",
    "corpus:unclosable-map": "node scripts/emit-unclosable-vetoes.ts",
    "corpus:grants-map": "node scripts/emit-grants-map.ts",
    "capture:check": "tsx src/harnesses/capture-check.ts",
    "capture:explain": "node scripts/explain-capture.ts",
    "layers:compare": "A11Y_PYTHON=.venv/bin/python node scripts/compare-layers.ts",
    "identity:rate": "tsx src/harnesses/page-identity-rate.ts",
    "verdict:stability": "tsx src/harnesses/occurrence-verdict-stability.ts",
    "verdict:preregistered": "node scripts/check-preregistered-verdict.ts",
    "scorer:size-sensitivity": "node scripts/audit-size-sensitivity.ts",
    "scorer:shortcuts:baseline": "pnpm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "scorer:shortcuts:candidate": "pnpm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --no-baseline",
    "training:evaluate-acceptance:candidate": ".venv/bin/python scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --training-data runs/screenreader-dataset/with-realism.jsonl --model runs/model-candidate --training-report runs/model-candidate/training-report.json --out runs/model-candidate/acceptance-report.json",
    "corpus:urls": "node scripts/audit-corpus-urls.ts",
    "scorer:verify": "node scripts/verify-safetensors.ts node_modules/@a11ign/scorer/models/screenreader-scorer",
    "release:provenance": "node scripts/check-shipped-provenance.ts",
    "release:rehearsal-check": "node scripts/check-rehearsal-currency.ts",
    "corpus:distribution": "node scripts/check-dataset-distribution.ts",
    "corpus:observation-ambiguity": "node scripts/audit-observation-ambiguity.ts",
    "corpus:route-change-identity": "node scripts/audit-route-change-identity.ts",
    "corpus:focus-log-first-event": "node scripts/audit-focus-log-first-event.ts",
    "gate:probe-order": "node scripts/gate-probe-order.ts",
    "lab:collect-promotion": "node scripts/collect-promotion.ts",
    "scorer:shortcuts:baseline:candidate": "pnpm run --silent corpus:unclosable-map && .venv/bin/python scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "fleet:hours": "node scripts/fleet-hours.ts",
    "corpus:release": "node scripts/corpus-release.ts",
    "corpus:release-nightly": "node scripts/corpus-release-nightly.ts"
  },
  "dependencies": {
    "@a11ign/evidence": "0.2.0",
    "@a11ign/judge": "0.2.3",
    "@a11ign/scorer": "0.2.1",
    "@a11ign/screenreader-fleet": "^0.5.1",
    "@a11ign/screenreader-worker": "^0.1.0"
  },
  "devDependencies": {
    "@a11ign/control": "0.1.0",
    "@a11ign/toolchain": "0.7.0",
    "@changesets/cli": "3.0.3",
    "@guidepup/guidepup": "0.35.0",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "^26.6.4",
    "a11ign": "0.2.7",
    "serve": "14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
